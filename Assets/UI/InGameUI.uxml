<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1;">
        <ui:Label text="Label" name="TimeCounter" style="justify-content: center; -unity-text-align: upper-center; font-size: 17px; width: 200px; align-items: center; align-self: center; height: 10%; -unity-text-auto-size: best-fit 10px 100px; -unity-text-generator: advanced;"/>
        <ui:ProgressBar value="22" title="my-progress" name="ExperienceBar" style="width: 50%; justify-content: center; align-self: center; height: 5%;"/>
    </ui:VisualElement>
</ui:UXML>
